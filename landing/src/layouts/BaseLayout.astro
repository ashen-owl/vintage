---
import "@styles/global.css";
import SparkleField from "@components/ui/SparkleField.astro";
import { skipLinkLabel } from "@data/site";
import type { SiteMeta } from "@interfaces/index";
import { withBase } from "@utils/with-base";

interface Props {
  meta: SiteMeta;
}

const { meta } = Astro.props;
const faviconHref = withBase("/favicon.svg");
const ogImagePath = withBase(meta.ogImage);
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site).href : ogImagePath;
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Marcellus+SC&family=MonteCarlo&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="shortcut icon" href={faviconHref} type="image/svg+xml" />
    <meta property="og:image" content={ogImageUrl} />
  </head>
  <body>
    <a
      class="fixed top-3 left-3 z-20 -translate-y-[160%] focus:translate-y-0 px-4 py-[0.7rem] border border-antique-gold rounded-full text-old-ink bg-porcelain no-underline transition-transform duration-[220ms] ease-[ease]"
      href="#main"
    >
      {skipLinkLabel}
    </a>
    <SparkleField />
    <slot />
    <script>
      import "@scripts/main";
    </script>
  </body>
</html>
