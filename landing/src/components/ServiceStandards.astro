---
import ObservedSection from "@components/ui/ObservedSection.astro";
import { serviceStandards, serviceStandardsAriaLabel } from "@data/service-standards";
---

<ObservedSection ariaLabel={serviceStandardsAriaLabel} class="overflow-hidden border-y border-antique-gold/22 bg-old-lace/44">
  <div
    class="marquee__track reveal grid justify-start text-left tablet:flex tablet:justify-center tablet:text-center gap-[clamp(1rem,3vw,3rem)] px-gutter py-4 text-antique-gold font-utility text-[clamp(0.68rem,1vw,0.82rem)] tracking-[0.15em] uppercase"
  >
    {serviceStandards.map((standard) => <span class="standard">{standard}</span>)}
  </div>
</ObservedSection>

<style>
  @layer components {
    .standard {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      white-space: nowrap;
    }

    .standard::before {
      content: "✦";
      color: var(--color-champagne);
      font-size: 0.8rem;
    }
  }
</style>
