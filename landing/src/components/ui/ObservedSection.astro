---
interface Props {
  id?: string;
  labelledBy?: string;
  ariaLabel?: string;
  class?: string;
  hasMobileBottomSpacing?: boolean;
}

const { id, labelledBy, ariaLabel, class: className, hasMobileBottomSpacing = true } = Astro.props;
---

<section
  class:list={[
    "section-observed overflow-x-clip",
    hasMobileBottomSpacing && "max-md:pb-[calc(var(--spacing-section)+1rem)]",
    className,
  ]}
  id={id}
  aria-labelledby={labelledBy}
  aria-label={ariaLabel}
>
  <slot />
</section>
