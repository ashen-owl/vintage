---
import type { FormFieldConfig } from "@interfaces/index";

interface Props {
  field: FormFieldConfig;
}

const { field } = Astro.props;
---

<div class:list={["field-group grid gap-[0.45rem]", field.isFullWidth && "tablet:col-span-full"]}>
  <label for={field.id}>{field.label}</label>
  {
    field.kind === "select" ? (
      <select id={field.id} name={field.id} required={field.required}>
        {field.options?.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    ) : field.kind === "textarea" ? (
      <textarea id={field.id} name={field.id} rows={field.rows} placeholder={field.placeholder} required={field.required} />
    ) : (
      <input
        id={field.id}
        name={field.id}
        type={field.kind}
        autocomplete={field.autocomplete}
        placeholder={field.placeholder}
        required={field.required}
      />
    )
  }
  {field.required && <span class="field-error" data-error-for={field.id} />}
</div>

<style>
  @layer components {
    label {
      color: var(--color-antique-gold);
      font-family: var(--font-utility);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid color-mix(in srgb, var(--color-antique-gold) 32%, transparent);
      border-radius: 16px;
      padding: 0.9rem 1rem;
      color: var(--color-old-ink);
      background: color-mix(in srgb, var(--color-porcelain) 86%, transparent);
      transition: border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
    }

    textarea {
      resize: vertical;
    }

    option {
      padding: 0 2px 1px;
    }

    @supports (appearance: base-select) {
      select,
      select::picker(select) {
        appearance: base-select;
      }

      select {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        cursor: pointer;
      }

      select:has(option[value=""]:checked) {
        color: var(--color-soft-ink);
      }

      select::picker-icon {
        color: var(--color-antique-gold);
        transition: rotate 280ms var(--ease-ceremony);
      }

      select:open::picker-icon {
        rotate: 180deg;
      }

      select::picker(select) {
        margin-block: 0.45rem;
        padding: 0.4rem;
        border: 1px solid color-mix(in srgb, var(--color-antique-gold) 32%, transparent);
        border-radius: var(--radius-card);
        color: var(--color-old-ink);
        background: var(--color-field-focus);
        box-shadow: 0 1.2rem 2.6rem color-mix(in srgb, var(--color-umber) 16%, transparent);
        opacity: 0;
        translate: 0 -0.4rem;
        transition:
          opacity 220ms ease,
          translate 280ms var(--ease-ceremony),
          display 280ms allow-discrete,
          overlay 280ms allow-discrete;
      }

      select:open::picker(select) {
        opacity: 1;
        translate: 0 0;
      }

      @starting-style {
        select:open::picker(select) {
          opacity: 0;
          translate: 0 -0.4rem;
        }
      }

      option {
        gap: 0.8rem;
        padding: 0.7rem 0.9rem;
        border-radius: 12px;
        cursor: pointer;
        transition: background-color 180ms ease;
      }

      option:hover,
      option:focus-visible {
        outline: 0;
        background: color-mix(in srgb, var(--color-champagne) 22%, transparent);
      }

      option:checked {
        font-weight: 600;
      }

      option::checkmark {
        order: 1;
        margin-inline-start: auto;
        content: "✦";
        color: var(--color-champagne);
      }

      option[value=""] {
        display: none;
      }
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--color-antique-gold);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-champagne) 22%, transparent);
      outline: 0;
      background: var(--color-field-focus);
    }

    .field-error {
      min-height: 1.1rem;
      color: var(--color-wax-seal);
      font-family: var(--font-utility);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
  }
</style>
