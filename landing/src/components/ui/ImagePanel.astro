---
import type { ImageContent, PieceVariant } from "@interfaces/index";
import { withBase } from "@utils/with-base";

interface Props {
  image: ImageContent;
  variant: "hero" | PieceVariant | "atelier";
  class?: string;
}

const { image, variant, class: className } = Astro.props;
const isPiece = variant === "chain" || variant === "signet" || variant === "locket";
---

<div
  class:list={[
    "image-panel",
    `image-panel--${variant}`,
    variant === "hero" && "hero-image",
    isPiece && "piece-card__image",
    className,
  ]}
  role="img"
  aria-label={image.alt}
  style={`--panel-image: url("${withBase(image.src)}")`}
>
  <slot />
</div>

<style>
  @layer components {
    .image-panel {
      position: relative;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-antique-gold) 24%, transparent);
      border-radius: var(--radius-soft);
      background-color: var(--color-old-lace);
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover;
      box-shadow:
        0 1.5rem 3rem color-mix(in srgb, var(--color-umber) 13%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--color-white) 45%, transparent);
    }

    .image-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 28% 20%, color-mix(in srgb, var(--color-white) 58%, transparent), transparent 10rem),
        linear-gradient(
          155deg,
          color-mix(in srgb, var(--color-old-ink) 4%, transparent),
          color-mix(in srgb, var(--color-wax-seal) 14%, transparent)
        );
      mix-blend-mode: soft-light;
      pointer-events: none;
    }

    .image-panel::after {
      content: "";
      position: absolute;
      inset: 12px;
      border: 1px solid color-mix(in srgb, var(--color-champagne) 45%, transparent);
      border-radius: calc(var(--radius-soft) - 12px);
      pointer-events: none;
    }

    .piece-card__image {
      position: absolute;
      inset: 0;
      border: 0;
      border-radius: inherit;
      box-shadow: none;
    }

    .image-panel--hero {
      background-image:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--color-shadow-brown) 28%, transparent),
          color-mix(in srgb, var(--color-porcelain) 8%, transparent)
        ),
        var(--panel-image),
        radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--color-champagne) 75%, transparent), transparent 7.8rem),
        linear-gradient(
          135deg,
          var(--color-fallback-hero-start),
          var(--color-fallback-hero-gold) 38%,
          var(--color-fallback-cream) 72%,
          var(--color-fallback-hero-end)
        );
    }

    .image-panel--chain {
      background-image:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-old-ink) 58%, transparent),
          color-mix(in srgb, var(--color-old-ink) 2%, transparent) 58%
        ),
        var(--panel-image),
        radial-gradient(circle at 48% 26%, color-mix(in srgb, var(--color-champagne) 72%, transparent), transparent 8rem),
        linear-gradient(
          145deg,
          var(--color-fallback-cream),
          var(--color-fallback-chain-gold) 45%,
          var(--color-fallback-chain-end)
        );
    }

    .image-panel--signet {
      background-image:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-old-ink) 62%, transparent),
          color-mix(in srgb, var(--color-old-ink) 2%, transparent) 58%
        ),
        var(--panel-image),
        radial-gradient(circle at 58% 24%, color-mix(in srgb, var(--color-champagne) 76%, transparent), transparent 8rem),
        linear-gradient(
          145deg,
          var(--color-fallback-signet-start),
          var(--color-fallback-signet-gold) 48%,
          var(--color-old-lace)
        );
    }

    .image-panel--locket {
      background-image:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-old-ink) 60%, transparent),
          color-mix(in srgb, var(--color-old-ink) 2%, transparent) 58%
        ),
        var(--panel-image),
        radial-gradient(circle at 44% 30%, color-mix(in srgb, var(--color-champagne) 70%, transparent), transparent 8rem),
        linear-gradient(
          145deg,
          var(--color-fallback-locket-start),
          var(--color-fallback-locket-gold) 46%,
          var(--color-fallback-locket-end)
        );
    }

    .image-panel--atelier {
      background-image:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--color-old-ink) 32%, transparent),
          color-mix(in srgb, var(--color-porcelain) 4%, transparent)
        ),
        var(--panel-image),
        radial-gradient(circle at 48% 28%, color-mix(in srgb, var(--color-champagne) 76%, transparent), transparent 8rem),
        linear-gradient(
          150deg,
          var(--color-old-lace),
          var(--color-fallback-atelier-gold) 46%,
          var(--color-fallback-atelier-end)
        );
    }
  }
</style>
