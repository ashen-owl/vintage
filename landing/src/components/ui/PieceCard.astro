---
import ImagePanel from "@components/ui/ImagePanel.astro";
import type { Piece } from "@interfaces/index";

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
---

<article
  class:list={[
    "piece-card reveal relative flex flex-col justify-end overflow-hidden min-h-[33rem]",
    `piece-card--from-${piece.revealFrom}`,
    piece.isTall ? "desktop:min-h-[44rem]" : "desktop:min-h-[38rem]",
  ]}
  style={`--reveal-delay: ${piece.revealDelayMs}ms`}
>
  <ImagePanel image={piece.image} variant={piece.variant} />
  <div class="piece-card__body relative z-1 m-[0.85rem] p-[clamp(1.2rem,2vw,1.6rem)]">
    <p class="piece-card__kicker">{piece.kicker}</p>
    <h3 data-split>{piece.title}</h3>
    <p>{piece.description}</p>
    <div class="piece-card__meta flex flex-col tablet:flex-row justify-between gap-4 border-t border-transparent pt-[0.9rem]">
      <span>{piece.metal}</span>
      <span>{piece.price}</span>
    </div>
  </div>
</article>

<style>
  @layer components {
    .piece-card {
      border: 1px solid color-mix(in srgb, var(--color-antique-gold) 20%, transparent);
      border-radius: var(--radius-soft);
      background: color-mix(in srgb, var(--color-linen) 72%, transparent);
      box-shadow: 0 1.2rem 2.6rem color-mix(in srgb, var(--color-umber) 10%, transparent);
    }

    .piece-card__body {
      border: 1px solid color-mix(in srgb, var(--color-white) 48%, transparent);
      border-radius: 22px;
      color: var(--color-porcelain);
      background: color-mix(in srgb, var(--color-old-ink) 52%, transparent);
      backdrop-filter: blur(14px);
    }

    .piece-card__body h3,
    .piece-card__body p {
      color: inherit;
    }

    .piece-card__body p {
      margin-bottom: 1rem;
    }

    .piece-card__kicker,
    .piece-card__meta {
      font-family: var(--font-utility);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
  }
</style>
